#version 410 core
#extension GL_ARB_gpu_shader5 : enable
#extension GL_EXT_shader_image_load_store : require
#extension GL_ARB_shading_language_include : enable
#include "/glsl_common.glsl"
#include "/glsl_function.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 1) uniform sampler2DArray texSampler0;
layout(binding = 2, rgba8) writeonly uniform image2D texSampler1;


void main()
{
    uvec2 id = gl_GlobalInvocationID.xy;
    uvec2 coord = id;
    int index = 0;

    if (id.x < uint(_textureInfo.texInfo.x) &&
        id.y < uint(_textureInfo.texInfo.y))
    {
        index = _textureInfo.texIndexArray.x;
    }
    else if (id.x >= uint(_textureInfo.texInfo.x) &&
             id.y < uint(_textureInfo.texInfo.y))
    {
        index = _textureInfo.texIndexArray.y;
        coord.x -= uint(_textureInfo.texInfo.x);
    }
    else if (id.x < uint(_textureInfo.texInfo.x) &&
             id.y >= uint(_textureInfo.texInfo.y))
    {
        index = _textureInfo.texIndexArray.z;
        coord.y -= uint(_textureInfo.texInfo.y);
    }
    else
    {
        index = _textureInfo.texIndexArray.w;
        coord.x -= uint(_textureInfo.texInfo.x);
        coord.y -= uint(_textureInfo.texInfo.y);
    }

    vec4 pixel = texelFetch(texSampler0, ivec3(int(coord.x), int(coord.y), index), 0);
    if (_textureInfo.texInfo.w > 0)
    {
        pixel = Func_LinearToSRGB(pixel);
    }
    imageStore(texSampler1, ivec2(int(id.x), int(id.y)), pixel);
}