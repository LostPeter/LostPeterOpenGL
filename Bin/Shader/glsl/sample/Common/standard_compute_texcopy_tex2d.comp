#version 450 core
#extension GL_ARB_gpu_shader5 : enable
#extension GL_EXT_shader_image_load_store : require
#extension GL_ARB_shading_language_include : enable
#include "/glsl_common.glsl"
#include "/glsl_function.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D texSampler0;
layout(binding = 1, rgba8) writeonly uniform image2D texSampler1;


void main()
{
    uint coordX = gl_GlobalInvocationID.x;
    uint coordY = gl_GlobalInvocationID.y;

    TextureCopyConstant texCopy = textureCopyConsts.texCopy;

    bool inRange =
        coordX >= uint(texCopy.texOffset.x) &&
        coordX <  uint(texCopy.texOffset.x + texCopy.texInfo.x) &&
        coordY >= uint(texCopy.texOffset.y) &&
        coordY <  uint(texCopy.texOffset.y + texCopy.texInfo.y);

    if (inRange)
    {
        int sx = int(coordX - uint(texCopy.texOffset.x));
        int sy = int(coordY - uint(texCopy.texOffset.y));
        int mipLevel = int(texCopy.texInfo.z);

        vec4 pixel = texelFetch(texSampler0, ivec2(sx, sy), mipLevel);
        if (texCopy.texInfo.w > 0)
        {
            pixel = Func_LinearToSRGB(pixel);
        }
        imageStore(texSampler1, ivec2(int(coordX), int(coordY)), pixel);
    }
    else
    {
        imageStore(texSampler1, ivec2(int(coordX), int(coordY)), texCopy.texClearColor);
    }
}