#version 330 core
#extension GL_ARB_shading_language_include : enable
#include "/glsl_common.glsl"

in vec4 fragWorldPos;
in vec3 fragColor;

out vec4 outColor;

void main()
{
    outColor = vec4(fragColor.xyz, 1.0);
}